# Erklärungen für den HTML-Bericht von pc-check: je Prüfung Was / Warum / Wann harmlos.
# Schlüssel = Name der Prüfung genau wie im Bericht. Fehlt ein Eintrag, zeigt der Bericht die Kategorie-Erklärung.
@{
    Status     = @{
        CRIT = 'Kritisch: echtes Sicherheits- oder Stabilitätsrisiko. Zuerst beheben.'
        WARN = 'Warnung: sollte behoben werden, ist aber selten akut. Prüfen, ob es bewusst so gewollt ist.'
        ACK  = 'Akzeptiert: eine Warnung, die du in accepted.psd1 bewusst als gewollt eingetragen hast. Meldet sich nach Ablaufdatum oder wenn sich der Befund ändert wieder.'
        INFO = 'Hinweis: kein Problem, aber eine Information oder Optimierungsmöglichkeit. Kann ignoriert werden.'
        OK   = 'OK: alles in Ordnung.'
        SKIP = 'Nicht geprüft: meist fehlen Adminrechte oder die Funktion gibt es auf diesem PC nicht. Kein Befund.'
    }

    Kategorien = @{
        'System & Updates'           = 'Ein aktuelles, aktiviertes Windows ist die Grundlage aller Sicherheit: Die meisten Angriffe nutzen Lücken, für die es längst Updates gibt.'
        'Virenschutz'                = 'Microsoft Defender reicht für Privat-PCs völlig aus, solange alle Schutzfunktionen an und die Signaturen aktuell sind.'
        'Firewall & Netzwerk'        = 'Die Firewall entscheidet, was aus dem Netz auf den PC zugreifen darf. Offene Ports und Freigaben sind mögliche Einfallstore.'
        'Konten & Anmeldung'         = 'Wer sich anmelden kann und mit welchen Rechten. Unnötige oder ungeschützte Konten sind eine häufige Schwachstelle.'
        'Systemhärtung'              = 'Schutzfunktionen von Windows, die Angriffe erschweren, selbst wenn Schadsoftware schon läuft. Sie kosten kaum Leistung.'
        'Verschlüsselung & Firmware' = 'Schutz unterhalb von Windows: Startvorgang, Verschlüsselung der Daten und Firmware des Mainboards.'
        'Fernzugriff & Dienste'      = 'Programme und Dienste, die im Hintergrund mit hohen Rechten laufen oder Fernzugriff erlauben. Jedes unnötige davon ist Angriffsfläche.'
        'Autostart & Persistenz'     = 'Stellen, an denen sich Programme automatisch starten. Schadsoftware nistet sich genau hier ein.'
        'Software'                   = 'Veraltete Programme mit bekannten Lücken sind nach veraltetem Windows der häufigste Einfallsweg.'
        'Ereignisse'                 = 'Spuren in den Windows-Protokollen der letzten Tage, z. B. fehlgeschlagene Anmeldungen oder abgeschalteter Virenschutz.'
        'Hardware'                   = 'Ob die Hardware so läuft, wie sie kann: Treiber, Arbeitsspeicher-Takt, Bildwiederholrate, fehlerhafte Geräte.'
        'Laufwerke & Speicherplatz'  = 'Zustand und Belegung der Laufwerke. Volle oder alte Laufwerke bremsen und gefährden Daten.'
        'Energie'                    = 'Energiespar-Einstellungen, die die Leistung begrenzen können.'
        'Gaming & Grafik'            = 'Windows-Einstellungen, die Spiele flüssiger oder ruckeliger machen.'
        'Auslastung'                 = 'Momentaufnahme der Grundlast: Was im Hintergrund Rechenzeit und Speicher kostet.'
        'Stabilität'                 = 'Abstürze, Hardwarefehler und Probleme beim Start. Häufen sie sich, steckt oft Hardware, Übertaktung oder ein Treiber dahinter.'
    }

    Pruefungen = @{
        'Ausführungsumgebung'                        = @{ Was = 'Ob das Script aus einer Store-App heraus gestartet wurde.'; Warum = 'Store-Apps verfälschen für ihre Prozesse Teile der Registry. Dann können einzelne Ergebnisse falsch sein.'; Harmlos = 'Nie: einfach per Doppelklick auf pc-check.cmd neu starten.' }
        'Windows-Version'                            = @{ Was = 'Windows-Version und ob Microsoft dafür noch Sicherheitsupdates liefert.'; Warum = 'Nach dem Supportende werden neue Lücken nicht mehr geschlossen.'; Harmlos = 'Ein Hinweis zum Supportende in einigen Monaten ist normal; das Funktionsupdate kommt über Windows Update.' }
        'Windows-Aktivierung'                        = @{ Was = 'Ob Windows ordnungsgemäß aktiviert ist.'; Warum = 'Nicht aktivierte Systeme wurden oft mit dubiosen Aktivierungstools behandelt, die selbst Schadsoftware enthalten.'; Harmlos = 'Direkt nach einer Neuinstallation oder einem Hardwaretausch kann die Aktivierung kurz ausstehen.' }
        'Windows Update: Verlauf'                    = @{ Was = 'Wann zuletzt ein monatliches Sicherheitsupdate installiert wurde.'; Warum = 'Microsoft schließt jeden zweiten Dienstag im Monat Sicherheitslücken.'; Harmlos = 'Ein paar Tage nach dem Patchday kann das Update noch ausstehen.' }
        'Windows Update: Fehler'                     = @{ Was = 'Fehlgeschlagene Update-Installationen der letzten 30 Tage.'; Warum = 'Ein dauerhaft scheiterndes Update lässt Lücken offen.'; Harmlos = 'Ein einzelner Fehler, der beim nächsten Versuch geklappt hat.' }
        'Windows Update: ausstehend'                 = @{ Was = 'Updates, die bereitstehen, aber noch nicht installiert sind.'; Warum = 'Kritische Updates sollten zügig installiert werden.'; Harmlos = 'Optionale Treiberupdates und Defender-Signaturen sind kein Handlungsbedarf.' }
        'Neustart ausstehend'                        = @{ Was = 'Ob Windows für installierte Updates einen Neustart braucht.'; Warum = 'Viele Updates wirken erst nach dem Neustart.'; Harmlos = 'Direkt nach Updates normal; einfach demnächst neu starten.' }
        'Windows Update: Einstellungen'              = @{ Was = 'Ob automatische Updates abgeschaltet oder pausiert sind.'; Warum = 'Sogenannte Tuning-Tools schalten Updates gern ab; dann bleiben Lücken unbemerkt offen.'; Harmlos = 'Eine kurze, bewusste Pause (z. B. vor einer wichtigen Abgabe).' }
        'Registrierte Schutzprogramme'               = @{ Was = 'Welcher Virenschutz bei Windows angemeldet und aktiv ist.'; Warum = 'Ohne aktiven Virenschutz ist der PC ungeschützt; zwei gleichzeitig bremsen sich gegenseitig.'; Harmlos = 'Ein Fremd-Virenschutz statt Defender ist in Ordnung, solange genau einer aktiv ist.' }
        'Microsoft Defender: Status'                 = @{ Was = 'Ob Echtzeit-, Verhaltens- und Download-Schutz von Defender laufen.'; Warum = 'Das sind die Kernfunktionen des Virenschutzes.'; Harmlos = 'Ist ein anderer Virenschutz aktiv, schaltet sich Defender bewusst in den passiven Modus.' }
        'Defender: Manipulationsschutz'              = @{ Was = 'Ob Programme Defender-Einstellungen heimlich ändern können.'; Warum = 'Schadsoftware versucht als Erstes, den Virenschutz abzuschalten.'; Harmlos = 'Praktisch nie; sollte immer an sein.' }
        'Defender: Signaturen'                       = @{ Was = 'Wie alt die Virensignaturen sind.'; Warum = 'Veraltete Signaturen erkennen neue Schadsoftware nicht.'; Harmlos = 'Ein Tag Verzug, wenn der PC länger aus war.' }
        'Defender: Scans'                            = @{ Was = 'Wann Defender zuletzt einen Schnellscan gemacht hat.'; Warum = 'Regelmäßige Scans finden, was dem Echtzeitschutz entgangen ist.'; Harmlos = 'Wird der PC nur kurz genutzt, scannt Defender seltener; gelegentlich manuell scannen reicht.' }
        'Microsoft Defender: Einstellungen'          = @{ Was = 'Zusatzschutz wie Blockieren unerwünschter Apps, Cloud-Schutz, Netzwerkschutz, Ordnerschutz.'; Warum = 'Diese Funktionen fangen Dinge ab, die der Basisschutz nicht erkennt.'; Harmlos = 'Netzwerk- und Ordnerschutz sind optional; der Ordnerschutz meldet bei Spielen öfter Fehlalarme.' }
        'Defender: ASR-Regeln'                       = @{ Was = 'Regeln, die typische Angriffstechniken blockieren (z. B. Office startet Programme).'; Warum = 'Sie stoppen ganze Angriffsklassen, auch unbekannte.'; Harmlos = 'Auf Privat-PCs sind sie standardmäßig aus; das ist ein Hinweis, kein Fehler.' }
        'Defender: Ausnahmen'                        = @{ Was = 'Ordner, Programme und Dateitypen, die Defender nicht prüft.'; Warum = 'Zu breite Ausnahmen (ganze Laufwerke, Downloads, PowerShell) sind ein offenes Scheunentor.'; Harmlos = 'Eng gefasste Ausnahmen für einzelne Spiele- oder Projektordner.' }
        'Microsoft Defender: Funde'                  = @{ Was = 'Was Defender in den letzten Tagen gefunden hat.'; Warum = 'Eine aktive, nicht entfernte Bedrohung ist ein Notfall.'; Harmlos = 'Bereits entfernte Funde, z. B. eine abgefangene Datei aus einem Download.' }
        'Firewall-Profile'                           = @{ Was = 'Ob die Windows-Firewall in allen Netzwerkprofilen an ist und eingehend blockiert.'; Warum = 'Ohne Firewall ist jeder offene Dienst aus dem Netz erreichbar.'; Harmlos = 'Ist eine Fremd-Firewall aktiv, darf die Windows-Firewall aus sein.' }
        'Netzwerkprofile'                            = @{ Was = 'Ob dein Netzwerk als „Privat“ oder „Öffentlich“ eingestuft ist.'; Warum = 'Im Profil Öffentlich ist Windows vorsichtiger (keine Netzwerkerkennung).'; Harmlos = 'Zu Hause ist beides in Ordnung; unterwegs immer Öffentlich.' }
        'Firewall: eigene Eingangsregeln'            = @{ Was = 'Firewall-Regeln von Programmen, die eingehende Verbindungen erlauben.'; Warum = 'Alte Regeln für längst gelöschte Programme sammeln sich an und öffnen unnötig Türen.'; Harmlos = 'Regeln für Spiele und Launcher, die du nutzt, sind normal, solange der PC hinter einem Router steht.' }
        'Offene Netzwerkports'                       = @{ Was = 'Welche Programme auf Verbindungen aus dem Netzwerk warten.'; Warum = 'Dienste wie Datenbanken, VNC oder RDP sollten nicht unbeabsichtigt erreichbar sein.'; Harmlos = 'Windows-Standardports und Ports bekannter Programme (Steam, NVIDIA, Spotify) im Heimnetz.' }
        'Router-Portweiterleitungen (UPnP)'          = @{ Was = 'Ob Programme per UPnP Ports am Router geöffnet haben.'; Warum = 'Dann ist der PC direkt aus dem Internet erreichbar.'; Harmlos = 'Spiele und Konsolen öffnen gelegentlich Ports für Mehrspielerfunktionen.' }
        'SMB-Konfiguration'                          = @{ Was = 'Einstellungen der Windows-Dateifreigabe (SMB).'; Warum = 'Das veraltete SMBv1 war Einfallstor großer Angriffswellen (WannaCry).'; Harmlos = 'Fehlende Signierung ist im Heimnetz ein Hinweis, kein Risiko.' }
        'Freigaben'                                  = @{ Was = 'Ordner, die im Netzwerk freigegeben sind.'; Warum = 'Freigaben mit Schreibrecht für „Jeder“ kann jedes Gerät im Netz verändern.'; Harmlos = 'Bewusst eingerichtete Freigaben mit Benutzer-Anmeldung.' }
        'LLMNR / NetBIOS'                            = @{ Was = 'Alte Verfahren zur Namensauflösung im lokalen Netz.'; Warum = 'In fremden Netzen lassen sich darüber Anmelde-Hashes abgreifen.'; Harmlos = 'Bei einem Desktop, der nur im eigenen Heimnetz hängt.' }
        'Proxy und Hosts-Datei'                      = @{ Was = 'Ob der Internetverkehr über einen Proxy läuft oder die Hosts-Datei Adressen umleitet.'; Warum = 'Schadsoftware leitet Verkehr gern so um; Anti-Telemetrie-Tools blockieren damit Updates.'; Harmlos = 'Ein bewusst eingerichteter Firmen- oder Schul-Proxy.' }
        'DNS-Server'                                 = @{ Was = 'Welche DNS-Server die Netzwerkadapter nutzen.'; Warum = 'Manipulierte DNS-Server leiten auf gefälschte Seiten um.'; Harmlos = 'Router, Provider oder bekannte Anbieter (Google 8.8.8.8, Cloudflare 1.1.1.1, Quad9 9.9.9.9).' }
        'Lokale Benutzerkonten'                      = @{ Was = 'Welche Konten auf dem PC existieren und aktiv sind.'; Warum = 'Gastkonto und eingebautes Administratorkonto sind beliebte Angriffsziele.'; Harmlos = 'Eigene Konten und von Programmen angelegte, deaktivierte Systemkonten.' }
        'Administratorgruppe'                        = @{ Was = 'Wer volle Rechte auf dem PC hat.'; Warum = 'Jeder Administrator kann alles verändern, auch Schutzfunktionen.'; Harmlos = 'Ein Alltagskonto mit Adminrechten ist zu Hause üblich, solange die Benutzerkontensteuerung an ist.' }
        'Kennwort- und Sperrrichtlinie'              = @{ Was = 'Mindestlänge von Kennwörtern und Sperre nach Fehlversuchen.'; Warum = 'Ohne Sperre lassen sich Kennwörter lokaler Konten beliebig oft durchprobieren.'; Harmlos = 'Bei Anmeldung mit Microsoft-Konto und PIN (durch das TPM geschützt).' }
        'Automatische Anmeldung'                     = @{ Was = 'Ob sich Windows ohne Kennwort automatisch anmeldet.'; Warum = 'Dann hat jeder mit Zugang zum PC sofort Zugriff; ein im Klartext gespeichertes Kennwort ist kritisch.'; Harmlos = 'Bei einem reinen Medien-PC ohne persönliche Daten.' }
        'Bildschirmsperre'                           = @{ Was = 'Ob der PC nach Inaktivität automatisch sperrt.'; Warum = 'Schützt vor Zugriff, wenn man den Platz verlässt.'; Harmlos = 'Zu Hause ohne Mitbewohner unkritisch; einfach Win+L beim Weggehen.' }
        'Benutzerkontensteuerung (UAC)'              = @{ Was = 'Ob Windows vor Änderungen mit Adminrechten nachfragt.'; Warum = 'Ohne UAC läuft jedes Programm mit vollen Rechten.'; Harmlos = 'Nie abschalten.' }
        'Kernisolierung (VBS / Speicherintegrität)'  = @{ Was = 'Ob der Windows-Kern per Virtualisierung vor manipulierten Treibern geschützt ist.'; Warum = 'Einer der wirksamsten Schutzmechanismen gegen tief sitzende Schadsoftware.'; Harmlos = 'Wenn ein benötigter, alter Treiber sie verhindert; Windows-Sicherheit zeigt dann, welcher.' }
        'LSA-Schutz'                                 = @{ Was = 'Ob der Prozess, der Anmeldedaten verwaltet, besonders geschützt ist.'; Warum = 'Erschwert das Auslesen von Kennwörtern aus dem Speicher.'; Harmlos = 'Selten; sollte an sein.' }
        'Treiber-Sperrliste und Smart App Control'   = @{ Was = 'Ob Windows bekannte anfällige Treiber blockiert und ob Smart App Control aktiv ist.'; Warum = 'Angreifer laden alte, anfällige Treiber, um Schutzfunktionen auszuschalten.'; Harmlos = 'Smart App Control aus ist normal; sie lässt sich nur bei einer Neuinstallation einschalten.' }
        'SmartScreen'                                = @{ Was = 'Ob Windows heruntergeladene Programme und Webseiten auf Reputation prüft.'; Warum = 'SmartScreen warnt vor bekannter Schadsoftware und Betrugsseiten.'; Harmlos = 'Praktisch nie; sollte an sein.' }
        'Exploit-Schutz (systemweit)'                = @{ Was = 'Grundlegende Speicherschutzfunktionen (DEP, ASLR, CFG, SEHOP).'; Warum = 'Sie erschweren das Ausnutzen von Programmfehlern erheblich.'; Harmlos = 'Nie; abgeschaltete Werte stammen meist von Tuning-Tools.' }
        'Spectre/Meltdown-Schutz'                    = @{ Was = 'Ob Schutzmaßnahmen gegen CPU-Lücken per Registry abgeschaltet wurden.'; Warum = 'Ein bekannter, aber wirkungsloser „Performance-Tweak“ mit echtem Risiko.'; Harmlos = 'Nur auf Test-PCs ohne persönliche Daten.' }
        'CPU-Microcode'                              = @{ Was = 'Welche Microcode-Version die CPU nutzt.'; Warum = 'Microcode-Updates schließen Sicherheitslücken in der CPU selbst.'; Harmlos = 'Reine Information; neuer Microcode kommt per BIOS- oder Windows-Update.' }
        'PowerShell-Sicherheit'                      = @{ Was = 'Ob PowerShell-Skripte aus dem Internet ohne Warnung laufen dürfen.'; Warum = 'Unrestricted/Bypass als Dauereinstellung erleichtert Angriffe per Skript.'; Harmlos = 'RemoteSigned für eigene Skripte; ein einmaliges Bypass beim Start (wie bei pc-check) ändert nichts dauerhaft.' }
        'Veraltete Anmeldeverfahren und Protokolle'  = @{ Was = 'Alte Anmeldeverfahren (WDigest, LM/NTLMv1) und Verschlüsselungen (SSL, TLS 1.0/1.1).'; Warum = 'Sie sind geknackt und lassen Kennwörter oder Verbindungen abgreifen.'; Harmlos = 'Nur für sehr alte Geräte im Heimnetz nötig.' }
        'Optionale Windows-Features'                 = @{ Was = 'Eingeschaltete Zusatzfunktionen von Windows.'; Warum = 'Alte Features wie SMBv1, PowerShell 2.0 oder Telnet sind unnötige Angriffsfläche.'; Harmlos = 'Hyper-V, WSL oder .NET 3.5 für Programme, die du nutzt.' }
        'Entwicklermodus und sudo'                   = @{ Was = 'Ob Funktionen für Softwareentwickler aktiv sind.'; Warum = 'Sie lockern einige Schutzfunktionen.'; Harmlos = 'Für Entwickler normal; sonst ausschalten.' }
        'Secure Boot'                                = @{ Was = 'Ob nur signierte Software den PC starten darf.'; Warum = 'Schützt vor Schadsoftware, die sich vor Windows einnistet (Bootkits). Viele Anti-Cheat-Systeme verlangen es.'; Harmlos = 'Bei Dual-Boot mit manchen Linux-Varianten; sonst einschalten.' }
        'Secure-Boot-Zertifikate 2023'               = @{ Was = 'Ob die neuen Microsoft-Zertifikate für Secure Boot im Mainboard hinterlegt sind.'; Warum = 'Die alten Zertifikate von 2011 sind 2026 abgelaufen; ohne die neuen gibt es keine Updates für den Startvorgang mehr.'; Harmlos = 'Windows Update spielt sie meist selbst ein; sonst hilft ein BIOS-Update.' }
        'TPM'                                        = @{ Was = 'Ob der Sicherheitschip (TPM) vorhanden und bereit ist.'; Warum = 'Er schützt Schlüssel für BitLocker, PIN und Windows Hello.'; Harmlos = 'Bei manchen Mainboards muss er im BIOS eingeschaltet werden (Intel PTT, AMD fTPM).' }
        'BitLocker'                                  = @{ Was = 'Ob das Systemlaufwerk verschlüsselt ist.'; Warum = 'Schützt Daten bei Diebstahl, Reparatur oder Entsorgung des Laufwerks.'; Harmlos = 'Bei einem Desktop zu Hause oft bewusst aus. Wichtig: Wiederherstellungsschlüssel sicher aufheben, falls an.' }
        'BIOS/UEFI-Version'                          = @{ Was = 'Version und Alter der Mainboard-Firmware.'; Warum = 'BIOS-Updates bringen CPU-Sicherheitsfixes und neue Secure-Boot-Zertifikate.'; Harmlos = 'Ältere Mainboards bekommen oft keine Updates mehr; dann ist nichts zu tun.' }
        'Wiederherstellung'                          = @{ Was = 'Windows-Wiederherstellungsumgebung und Wiederherstellungspunkte.'; Warum = 'Retten Windows nach fehlerhaften Updates oder Treibern.'; Harmlos = 'Fehlende Wiederherstellungspunkte sind ein Hinweis; eine Datensicherung ersetzen sie nicht.' }
        'Remotedesktop'                              = @{ Was = 'Ob sich andere per Remotedesktop auf diesen PC verbinden können.'; Warum = 'RDP ist eines der meistangegriffenen Einfallstore, wenn es aus dem Internet erreichbar ist.'; Harmlos = 'Wenn du dich bewusst aus dem Heimnetz verbindest.' }
        'Remoteunterstützung'                        = @{ Was = 'Ob Windows-Remoteunterstützung erlaubt ist.'; Warum = 'Wird bei Telefonbetrug („Microsoft-Support“) missbraucht.'; Harmlos = 'Wenn du sie zur Hilfe für Familie nutzt.' }
        'Fernzugriffsdienste und -programme'         = @{ Was = 'Installierte Fernwartungsprogramme (TeamViewer, AnyDesk …) und Fernverwaltungsdienste.'; Warum = 'Ungenutzte Fernwartung ist ein häufiger Einfallsweg, besonders bei Betrugsanrufen.'; Harmlos = 'Ein aktuelles Programm, das du selbst bewusst nutzt.' }
        'Dienste von Drittanbietern'                 = @{ Was = 'Hintergrunddienste anderer Hersteller und ob sie digital signiert sind.'; Warum = 'Unsignierte Dienste laufen mit Systemrechten, ohne dass ihre Herkunft belegt ist.'; Harmlos = 'Ältere Treibersoftware bekannter Hersteller (Drucker, Mäuse) ist oft unsigniert.' }
        'Dienstpfade und Berechtigungen'             = @{ Was = 'Ob Dienste so eingerichtet sind, dass normale Benutzer sie manipulieren könnten.'; Warum = 'Darüber kann sich Schadsoftware Systemrechte verschaffen.'; Harmlos = 'Pfade ohne Anführungszeichen unter Program Files sind nur theoretisch angreifbar, sollten aber korrigiert werden.' }
        'Treiber: bekannt anfällige und unsignierte' = @{ Was = 'Treiber mit bekannten Lücken (z. B. aus RGB-, OC- oder Monitoring-Tools) und unsignierte Treiber.'; Warum = 'Angreifer und Cheats laden genau solche Treiber, um Schutzfunktionen auszuschalten.'; Harmlos = 'Treiber, die nur noch als „entfernt“ in den Protokollen stehen.' }
        'Autostart-Einträge'                         = @{ Was = 'Programme, die sich beim Anmelden automatisch starten.'; Warum = 'Schadsoftware trägt sich hier ein; zu viele Einträge verlangsamen den Start.'; Harmlos = 'Unsignierte Tools bekannter Hersteller (z. B. Maussoftware).' }
        'Systemnahe Autostarts (Winlogon, IFEO, AppInit)' = @{ Was = 'Versteckte Startmöglichkeiten tief im System.'; Warum = 'Normale Programme nutzen sie praktisch nie; Schadsoftware schon.'; Harmlos = 'Process Explorer als Ersatz für den Task-Manager.' }
        'Geplante Aufgaben'                          = @{ Was = 'Automatisch geplante Aufgaben von Drittanbietern.'; Warum = 'Ein beliebter Ort für Schadsoftware, sich dauerhaft einzunisten.'; Harmlos = 'Updater von Browsern, Grafiktreibern und Spiele-Launchern.' }
        'WMI-Ereignisabonnements'                    = @{ Was = 'Versteckte Automatismen über die Windows-Verwaltungsschnittstelle.'; Warum = 'Wird von dateiloser Schadsoftware genutzt.'; Harmlos = 'Einträge von Herstellertools (z. B. Dell, HP); sonst genau prüfen.' }
        'Laufende Programme (Signatur und Ort)'      = @{ Was = 'Laufende Programme ohne gültige digitale Signatur.'; Warum = 'Unsignierte Programme aus Benutzerordnern sind ein typisches Muster von Schadsoftware.'; Harmlos = 'Kleine Tools, Open-Source-Programme (z. B. Git Bash) und Treibersoftware.' }
        'Browser-Erweiterungen'                      = @{ Was = 'Installierte Erweiterungen in Chrome, Edge, Brave, Vivaldi, Opera und Firefox.'; Warum = 'Erweiterungen mit Zugriff auf alle Webseiten können Kennwörter und Sitzungen mitlesen; verwaiste werden gern verkauft und missbraucht.'; Harmlos = 'Bekannte, gepflegte Erweiterungen wie Werbeblocker oder Passwortmanager.' }
        'Installierte Programme'                     = @{ Was = 'Programme mit bekannten Lücken oder ohne Herstellersupport.'; Warum = 'Veraltete Programme sind ein häufiger Einfallsweg, z. B. über manipulierte Dateien.'; Harmlos = 'Selten; aktualisieren oder deinstallieren.' }
        'Software-Updates (winget)'                  = @{ Was = 'Programme, für die eine neuere Version verfügbar ist.'; Warum = 'Updates schließen Sicherheitslücken. pc-check bietet sie am Ende zur Installation an.'; Harmlos = 'Spiele-Launcher und Programme mit eigener Update-Funktion aktualisieren sich selbst.' }
        'Fehlgeschlagene Anmeldungen'                = @{ Was = 'Falsche Kennworteingaben der letzten Tage.'; Warum = 'Viele Fehlversuche, besonders aus dem Internet, deuten auf einen Angriff hin.'; Harmlos = 'Vertipper und Windows-Anmeldedialoge (msedgewebview2) ohne Kontonamen.' }
        'Netzwerk- und RDP-Anmeldungen'              = @{ Was = 'Erfolgreiche Anmeldungen über das Netzwerk oder per Remotedesktop.'; Warum = 'Unerwartete Anmeldungen von außen wären ein Notfall.'; Harmlos = 'Eigene Verbindungen aus dem Heimnetz.' }
        'Konto- und Gruppenänderungen'               = @{ Was = 'Angelegte, geänderte oder in Gruppen aufgenommene Konten.'; Warum = 'Angreifer legen sich gern eigene Administratorkonten an.'; Harmlos = 'Kontoänderungen durch das System (Abgleich mit dem Microsoft-Konto) oder durch Installationen.' }
        'Gelöschte Ereignisprotokolle'               = @{ Was = 'Ob die Windows-Protokolle geleert wurden.'; Warum = 'Angreifer verwischen so ihre Spuren.'; Harmlos = 'Aufräumprogramme wie CCleaner leeren Protokolle auch.' }
        'Neu installierte Dienste'                   = @{ Was = 'Dienste und Treiber, die in den letzten Tagen installiert wurden.'; Warum = 'Zeigt, was sich neu im System eingenistet hat.'; Harmlos = 'Dienste von Updates und Programmen, die du selbst installiert hast.' }
        'Defender-Ereignisse'                        = @{ Was = 'Erkennungen, Abschaltungen und Konfigurationsänderungen von Defender.'; Warum = 'Abgeschalteter Schutz oder neue Ausnahmen ohne dein Zutun sind ein Warnzeichen.'; Harmlos = 'Änderungen, die du selbst vorgenommen hast.' }
        'Auffällige PowerShell-Skripte'              = @{ Was = 'Skripte, die Windows als verdächtig protokolliert hat.'; Warum = 'Schadsoftware nutzt PowerShell häufig.'; Harmlos = 'Installer und Verwaltungsskripte lösen das oft aus.' }
        'Neue Firewall-Regeln'                       = @{ Was = 'Firewall-Regeln, die in den letzten Tagen angelegt wurden.'; Warum = 'Zeigt, welche Programme sich neu Zugang aus dem Netz verschafft haben.'; Harmlos = 'Regeln von Spielen und Programmen, die du gerade installiert hast.' }
        'Blockierte Treiber/Dateien (Code Integrity)' = @{ Was = 'Dateien und Treiber, die Windows wegen fehlender Signatur blockiert hat.'; Warum = 'Zeigt, dass Schutzfunktionen greifen.'; Harmlos = 'Meist harmlos, z. B. alte DLLs in Spielen.' }
        'Prozessor'                                  = @{ Was = 'CPU-Modell und der gemessene Takt.'; Warum = 'Zeigt, ob die CPU ihren Turbo erreicht.'; Harmlos = 'Reine Information.' }
        'Arbeitsspeicher'                            = @{ Was = 'RAM-Größe, Takt und ob Dual-Channel aktiv ist.'; Warum = 'Ohne XMP/EXPO und mit nur einem Modul verschenkt man spürbar Leistung.'; Harmlos = 'Laptops und Fertig-PCs laufen oft absichtlich mit Standardtakt.' }
